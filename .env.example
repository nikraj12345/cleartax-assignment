# Database
DATABASE_URL=postgresql://brightpath:brightpath@localhost:5432/brightpath

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=brightpath_knowledge

# Auth
JWT_SECRET=change-me-in-production-min-32-chars-long
ORCHESTRATOR_SERVICE_TOKEN=orchestrator-internal-service-token
MOCK_PAYMENT_WEBHOOK_SECRET=mock-webhook-secret-demo

# OpenAI (optional in CI with LLM_MODE=fixture)
OPENAI_API_KEY=secret
LLM_MODE=live
OPENAI_MODEL=gpt-4o-mini

# Service URLs (local dev)
API_PORT=3001
ORCHESTRATOR_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3001
ORCHESTRATOR_URL=http://localhost:3002
API_URL=http://localhost:3001

# E2E
E2E_API_URL=http://localhost:3001
E2E_ORCHESTRATOR_URL=http://localhost:3002

# When testing against docker-compose-full, use:
# ORCHESTRATOR_SERVICE_TOKEN=docker-orchestrator-token
# JWT_SECRET=docker-demo-jwt-secret-min-32-chars